# Configuration du build LexOS Pro
# Dépôt du moteur (Termux) — intact, récupéré au moment de la compilation.
TERMUX_REPO=https://github.com/termux/termux-app
# Version EXACTE du moteur (commit figé = build reproductible).
# Pour suivre une nouvelle version de Termux, change ce commit puis repousse.
TERMUX_REF=8629e632fcb95da272221be327db653fb24befe9
# Nom affiché de l'application.
LEXOS_APP_NAME=LexOS Pro

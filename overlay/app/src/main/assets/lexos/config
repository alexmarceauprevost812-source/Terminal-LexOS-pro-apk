# Config de l'assistant IA LexOS (~/.lexos/config)
#
# Moteur : "llama" (llama.cpp — fiable sur Android, défaut) ou "ollama"
LEXAI_BACKEND="llama"

# --- llama.cpp (défaut) ---
# Le modèle .gguf est téléchargé et démarré automatiquement par 'lexos-ia'.
# Pour réutiliser le MÊME modèle que CodexLocal, mets son chemin ici :
# LEXAI_GGUF="$HOME/storage/shared/Models/DeepSeek-R1-Distill-Qwen-1.5B-Q4_K_M.gguf"
LEXAI_LLAMA_URL="http://127.0.0.1:8080"

# --- Si LEXAI_BACKEND="ollama" (souvent cassé sur Android) ---
LEXAI_MODEL="llama3.2:1b"
LEXAI_URL="http://127.0.0.1:11434"

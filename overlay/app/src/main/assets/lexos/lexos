#!/data/data/com.termux/files/usr/bin/env bash
# =====================================================================
#  lexos — raccourcis LexOS Pro
#     lexos maj        met à jour l'application (depuis la branche main)
#     lexos parler     parle à l'IA (le codex)
#     lexos couleurs   active toutes les couleurs
# =====================================================================
set -u
B=$'\e[1;38;2;248;120;0m'; D=$'\e[2m'; R=$'\e[0m'

case "${1:-}" in
    menu|accueil|demarrer|start)
        exec lexos-menu ;;
    maj|màj|mise|miss|"mise-à-jour"|mise-a-jour|update|up|mettre)
        shift; exec lexos-update "$@" ;;
    ia|installer|install|installe)
        shift; exec lexos-ia "$@" ;;
    parler|parle|chat|lex|aide)
        shift; exec aide "$@" ;;
    couleurs|couleur|color)
        exec lexos-couleurs ;;
    outils|outil|catalogue|tools)
        exec catalogue ;;
    facile|debutant|débutant|simple)
        exec lexos-facile ;;
    profil|bienvenue|config-depart)
        exec lexos-bienvenue ;;
    explique|expliquer|explications)
        shift
        prof="$HOME/.lexos/profil"; mkdir -p "$HOME/.lexos"; touch "$prof"
        case "${1:-}" in off|non|0|stop) val=off ;; *) val=on ;; esac
        grep -v '^LEXOS_EXPLIQUE=' "$prof" > "$prof.tmp" 2>/dev/null || true
        mv "$prof.tmp" "$prof" 2>/dev/null || true
        printf 'LEXOS_EXPLIQUE="%s"\n' "$val" >> "$prof"
        echo "${B}Mode explique-moi : $val${R}"
        echo "${D}Effet au prochain terminal (rouvre LexOS).${R}" ;;
    partage|partager|qr|share)
        exec lexos-partage ;;
    fichier|fichiers|file|envoyer)
        shift; exec lexos-fichier "$@" ;;
    recevoir|recois|reçois)
        exec lexos-fichier recevoir ;;
    nom|name|prenom|prénom)
        shift
        cfg="$HOME/.lexos/config"; mkdir -p "$HOME/.lexos"; touch "$cfg"
        n="$*"
        if [ -z "$n" ]; then
            cur=$(. "$cfg" 2>/dev/null; echo "${LEXOS_NAME:-ti-lex}")
            echo "Nom actuel de l'invite : ${B}$cur${R}"
            echo "${D}Changer : lexos nom <ton-nom>${R}"
            exit 0
        fi
        grep -v '^LEXOS_NAME=' "$cfg" > "$cfg.tmp" 2>/dev/null || true
        mv "$cfg.tmp" "$cfg" 2>/dev/null || true
        printf 'LEXOS_NAME="%s"\n' "$n" >> "$cfg"
        echo "${B}Nom de l'invite : $n${R}"
        echo "${D}Recharge : source ~/.lexos/lexos.sh  (ou rouvre le terminal)${R}" ;;
    kali-install|installer-kali|install-kali)
        exec lexos-kali ;;
    kali|nethunter)
        shift; exec kali "$@" ;;
    "")
        exec lexos-menu ;;
    -h|--help|aide-moi)
        echo "${B}lexos${R} — raccourcis LexOS Pro"
        echo "  ${B}lexos menu${R}       ouvrir le menu d'accueil (1 à 4)"
        echo "  ${B}lexos ia${R}         installer / démarrer l'IA locale"
        echo "  ${B}lexos parler${R}     parler à l'IA (le codex)"
        echo "  ${B}lexos maj${R}        mettre à jour l'application"
        echo "  ${B}lexos couleurs${R}   activer toutes les couleurs"
        echo "  ${B}lexos kali${R}       installer / entrer dans Kali"
        echo "  ${B}lexos outils${R}     catalogue des outils d'audit"
        echo "  ${B}lexos facile${R}     mode débutant (tout par numéros)"
        echo "  ${B}lexos profil${R}     refaire la configuration de départ"
        echo "  ${B}lexos explique on/off${R}  avertir avant les commandes risquées"
        echo "  ${B}lexos nom <nom>${R}  mettre ton nom dans l'invite"
        echo "  ${B}lexos partage${R}    partager LexOS par QR code"
        echo "  ${B}lexos fichier <f>${R} envoyer un fichier par QR"
        echo "  ${B}lexos recevoir${R}   recevoir un fichier par QR"
        echo "${D}(tu peux aussi écrire : lexos mise à jour)${R}" ;;
    *)
        echo "Commande inconnue : ${1}"
        echo "${D}Essaie :${R} lexos maj   ·   lexos parler   ·   lexos couleurs" ;;
esac

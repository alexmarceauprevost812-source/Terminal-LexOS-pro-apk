#!/data/data/com.termux/files/usr/bin/env bash
# =====================================================================
#  lexos-fichier — partage de fichiers par QR code (sur le même Wi-Fi).
#    lexos-fichier <fichier>   ENVOYER : QR à scanner pour télécharger
#    lexos-fichier recevoir    RECEVOIR : page d'upload, QR à scanner
#  Fonctionne entre téléphone et ordi tant qu'ils sont sur le même réseau.
#  Menu → « Partager un fichier ».
# =====================================================================
set -u
O=$'\e[1;38;2;248;120;0m'; G=$'\e[1;38;2;118;185;0m'; D=$'\e[2m'; RED=$'\e[1;31m'; R=$'\e[0m'

PORT="${LEXOS_FICHIER_PORT:-8088}"
PY="$(command -v python3 || command -v python || true)"
[ -z "$PY" ] && { echo "${D}Installation de Python…${R}"; pkg install -y python >/dev/null 2>&1 || true; PY="$(command -v python3 || command -v python || true)"; }
[ -z "$PY" ] && { echo "${RED}Python requis et introuvable.${R}"; exit 1; }
command -v qrencode >/dev/null 2>&1 || { echo "${D}Installation de l'outil QR…${R}"; pkg install -y qrencode >/dev/null 2>&1 || true; }

# IP locale (Wi-Fi), en évitant 127.x
ip_lan() {
    local a
    a=$(ip -4 addr show 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1 | grep -vE '^127\.' | head -n1)
    [ -z "$a" ] && a=$(ifconfig 2>/dev/null | awk '/inet /{print $2}' | grep -vE '^127\.' | head -n1)
    printf '%s' "$a"
}

show_qr() {   # $1 = url
    echo
    if command -v qrencode >/dev/null 2>&1; then
        echo "${G}Scanne ce code avec l'autre appareil :${R}"; echo
        qrencode -m 1 -t ANSIUTF8 "$1"
    fi
    echo
    echo "${O}Adresse :${R} ${G}$1${R}"
    echo "${D}(Les deux appareils doivent être sur le même Wi-Fi. Ctrl-C pour arrêter.)${R}"
}

envoyer() {
    local f="$1"
    [ -f "$f" ] || { echo "${RED}Fichier introuvable : $f${R}"; exit 1; }
    local ip name dir; ip="$(ip_lan)"
    [ -z "$ip" ] && { echo "${RED}Pas d'adresse Wi-Fi trouvée (connecté au Wi-Fi ?).${R}"; exit 1; }
    name="$(basename "$f")"; dir="$(cd "$(dirname "$f")" && pwd)"
    clear 2>/dev/null
    echo "${O}❯_ LexOS${R} Envoyer : ${G}$name${R}"
    show_qr "http://$ip:$PORT/$name"
    # Sert uniquement ce dossier ; l'ami télécharge /name
    ( cd "$dir" && "$PY" -m http.server "$PORT" >/dev/null 2>&1 )
}

recevoir() {
    local ip; ip="$(ip_lan)"
    [ -z "$ip" ] && { echo "${RED}Pas d'adresse Wi-Fi trouvée (connecté au Wi-Fi ?).${R}"; exit 1; }
    local dest="${1:-$HOME/storage/downloads}"; [ -d "$dest" ] || dest="$HOME"
    clear 2>/dev/null
    echo "${O}❯_ LexOS${R} Recevoir un fichier → ${G}$dest${R}"
    show_qr "http://$ip:$PORT/"
    LEXOS_DEST="$dest" "$PY" - "$PORT" <<'PYEOF'
import http.server, socketserver, os, sys, cgi
port=int(sys.argv[1]); dest=os.environ.get("LEXOS_DEST", os.path.expanduser("~"))
PAGE=b'<!doctype html><meta name=viewport content="width=device-width,initial-scale=1"><body style="font-family:sans-serif;background:#0b0b0b;color:#eee;text-align:center;padding:30px"><h2 style="color:#ff8700">LexOS - Envoyer un fichier</h2><form method=post enctype=multipart/form-data><input type=file name=f><br><br><button style="background:#ff8700;border:0;color:#000;padding:12px 20px;border-radius:8px;font-size:16px">Envoyer</button></form></body>'
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self,*a): pass
    def do_GET(self):
        self.send_response(200); self.send_header("Content-Type","text/html; charset=utf-8"); self.end_headers(); self.wfile.write(PAGE)
    def do_POST(self):
        form=cgi.FieldStorage(fp=self.rfile, headers=self.headers, environ={'REQUEST_METHOD':'POST','CONTENT_TYPE':self.headers['Content-Type']})
        item=form['f'] if 'f' in form else None
        if item is not None and getattr(item,'filename',''):
            name=os.path.basename(item.filename); path=os.path.join(dest,name)
            with open(path,'wb') as out: out.write(item.file.read())
            print("Reçu :", path)
            self.send_response(200); self.send_header("Content-Type","text/html; charset=utf-8"); self.end_headers()
            self.wfile.write(('<body style="font-family:sans-serif;background:#0b0b0b;color:#76b900;text-align:center;padding:40px"><h2>Recu ! '+name+'</h2></body>').encode())
        else:
            self.send_response(400); self.end_headers()
with socketserver.TCPServer(("",port),H) as s:
    s.serve_forever()
PYEOF
}

case "${1:-}" in
    recevoir|recois|reçois|in|recevoir-fichier) shift; recevoir "${1:-}" ;;
    ""|-h|--help|aide)
        echo "${O}lexos-fichier${R} — partage de fichiers par QR (même Wi-Fi)"
        echo "  ${O}lexos-fichier <fichier>${R}   envoyer (QR à scanner pour télécharger)"
        echo "  ${O}lexos-fichier recevoir${R}    recevoir (page d'upload + QR)"
        ;;
    *) envoyer "$1" ;;
esac

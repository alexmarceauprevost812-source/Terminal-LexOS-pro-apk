#!/data/data/com.termux/files/usr/bin/env bash
# =====================================================================
#  lexos-update — met à jour LexOS Pro depuis GitHub
#  Télécharge le dernier APK publié et ouvre l'installateur Android.
#  (Les mises à jour s'installent par-dessus car l'APK est signé avec
#   une clé stable.)
# =====================================================================
set -u
B=$'\e[1;38;2;248;120;0m'; D=$'\e[2m'; R=$'\e[0m'; RED=$'\e[1;31m'; G=$'\e[1;38;2;118;185;0m'

REPO="alexmarceauprevost812-source/Terminal-LexOS-pro-apk"
API="https://api.github.com/repos/$REPO/releases/latest"
APK_OUT="$HOME/.lexos/LexOS-Pro.apk"
ID_FILE="$HOME/.lexos/.update_id"
FORCE=0
[ "${1:-}" = "-f" ] || [ "${1:-}" = "--force" ] && FORCE=1
[ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && { echo "lexos-update [-f]  — met à jour LexOS Pro (-f : force)"; exit 0; }

# Dépendances
miss=""
command -v curl >/dev/null 2>&1 || miss="$miss curl"
command -v jq   >/dev/null 2>&1 || miss="$miss jq"
if [ -n "$miss" ]; then
    echo "${RED}Il manque :${R}$miss"
    printf "Les installer ? [O/n] "; read -r r
    case "$r" in ""|o|O|y|Y) pkg install -y $miss ;; *) exit 1 ;; esac
fi

echo "${B}❯_ LexOS${R} ${D}Vérification de la dernière version…${R}"
JSON=$(curl -fsSL --max-time 30 "$API" 2>/dev/null) || { echo "${RED}Pas de réseau ou dépôt injoignable.${R}"; exit 1; }

URL=$(printf '%s' "$JSON" | jq -r '.assets[] | select(.name|endswith(".apk")) | .browser_download_url' | head -n1)
TAG=$(printf '%s' "$JSON" | jq -r '.published_at // .id')
[ -z "$URL" ] || [ "$URL" = "null" ] && { echo "${RED}Aucun APK dans la dernière release.${R}"; exit 1; }

if [ "$FORCE" -eq 0 ] && [ -f "$ID_FILE" ] && [ "$(cat "$ID_FILE")" = "$TAG" ]; then
    echo "${G}Déjà à jour.${R} ${D}(forcer la réinstallation : lexos-update -f)${R}"
    exit 0
fi

echo "${D}Téléchargement…${R}"
mkdir -p "$(dirname "$APK_OUT")"
curl -fL --progress-bar "$URL" -o "$APK_OUT" || { echo "${RED}Échec du téléchargement.${R}"; exit 1; }

# L'installateur Android ne peut pas lire le dossier privé de l'app :
# on copie l'APK dans le stockage PARTAGÉ (Téléchargements), bien plus fiable.
SHARED=""
for d in "$HOME/storage/downloads" "$HOME/storage/shared/Download" "$HOME/storage/shared/Downloads"; do
    [ -d "$d" ] && { SHARED="$d/LexOS-Pro.apk"; break; }
done
if [ -z "$SHARED" ]; then
    echo "${Y}Pour que l'installation marche, j'ai besoin d'accéder au stockage.${R}"
    termux-setup-storage 2>/dev/null; sleep 2
    for d in "$HOME/storage/downloads" "$HOME/storage/shared/Download"; do
        [ -d "$d" ] && { SHARED="$d/LexOS-Pro.apk"; break; }
    done
fi

printf '%s' "$TAG" > "$ID_FILE"
CT="application/vnd.android.package-archive"

if [ -n "$SHARED" ] && cp -f "$APK_OUT" "$SHARED" 2>/dev/null; then
    echo "${G}Téléchargé.${R} Ouverture de l'installateur…"
    termux-open --content-type "$CT" --view "$SHARED" 2>/dev/null
    echo "${D}Si rien ne s'ouvre : ouvre l'appli « Fichiers » → Téléchargements → LexOS-Pro.apk${R}"
else
    echo "${G}Téléchargé.${R} Ouverture de l'installateur…"
    command -v termux-open >/dev/null 2>&1 && termux-open --content-type "$CT" --view "$APK_OUT" 2>/dev/null
    echo "${D}Si rien ne s'ouvre, installe à la main :${R} $APK_OUT"
fi

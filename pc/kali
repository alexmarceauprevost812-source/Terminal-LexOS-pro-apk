#!/usr/bin/env bash
# =====================================================================
#  kali — ouvre l'invite Kali (conteneur « kali-lexos ») dans le terminal.
#  Cherche distrobox/podman tout seul — PATH normal, /usr/local, /opt, et
#  surtout les montages USB (LexOS Nomad). Sinon se replie sur podman.
#    kali            -> shell Kali (sortir : exit)
#    kali <commande> -> lance une commande dans Kali (ex: kali nmap -h)
# =====================================================================
set -u

find_bin() { # $1 = nom du binaire
  local n="$1" p
  p="$(command -v "$n" 2>/dev/null)" && { printf '%s' "$p"; return; }
  for d in /usr/local/bin /usr/bin /usr/sbin /opt/*/bin; do
    [ -x "$d/$n" ] && { printf '%s' "$d/$n"; return; }
  done
  # Montages USB / amovibles (LexOS Nomad) — recherche bornée
  p="$(find /media /run/media /mnt -maxdepth 6 -type f -name "$n" 2>/dev/null | head -n1)"
  [ -n "$p" ] && printf '%s' "$p"
}

DB="$(find_bin distrobox)"
[ -z "$DB" ] && DB="$(find_bin distrobox-enter)"
PODMAN="$(find_bin podman)"

# distrobox a besoin de podman dans le PATH : on ajoute leurs dossiers.
[ -n "$DB" ]     && PATH="$(dirname "$DB"):$PATH"
[ -n "$PODMAN" ] && PATH="$(dirname "$PODMAN"):$PATH"
export PATH

PRE='export LANG=C.UTF-8 LC_ALL=C.UTF-8;'
SHELL_CMD="bash --norc -i"

# 1) distrobox
if [ -n "$DB" ]; then
  case "$DB" in
    *distrobox-enter)
      if [ "$#" -gt 0 ]; then exec "$DB" kali-lexos -- bash -lc "$PRE $*"
      else exec "$DB" kali-lexos -- bash -lc "$PRE exec $SHELL_CMD"; fi ;;
    *)
      if [ "$#" -gt 0 ]; then exec "$DB" enter kali-lexos -- bash -lc "$PRE $*"
      else exec "$DB" enter kali-lexos -- bash -lc "$PRE exec $SHELL_CMD"; fi ;;
  esac
fi

# 2) Repli : podman directement
if [ -n "$PODMAN" ]; then
  "$PODMAN" start kali-lexos >/dev/null 2>&1 || true
  if [ "$#" -gt 0 ]; then exec "$PODMAN" exec -it -e LANG=C.UTF-8 -e LC_ALL=C.UTF-8 kali-lexos "$@"
  else exec "$PODMAN" exec -it -e LANG=C.UTF-8 -e LC_ALL=C.UTF-8 kali-lexos bash --norc -i; fi
fi

echo "podman/distrobox introuvables (même sur les clés USB)." >&2
echo "La clé USB LexOS est-elle branchée et montée ? Sinon ouvre Kali avec Ctrl+Alt+K." >&2
exit 1
